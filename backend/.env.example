# 宠物宝 PetCare 环境配置模板 — 复制为 backend/.env 并填真实值（.env 已 gitignore，勿提交）
JWT_SECRET= *** 32 位随机串: python3 -c "import secrets;print(secrets.token_hex(32))"
DEBUG=false
CORS_ORIGINS=https://petcare.yjyblog.xyz,http://localhost:5173

# 火山方舟 AI 密钥（安全审计 2026-10：Web 进程不再读取 ~/.hermes/config.yaml）
ARK_API_KEY=

*** 微信小程序登录（微信公众平台 -> 开发管理 -> 开发设置）
WX_APPID=
WX_APP_SECRET=

*** 可选：AI 配额调整（默认值即可）
# AI_DAILY_LIMIT_USER=100
# AI_DAILY_LIMIT_IP=20
# LOGIN_LOCK_THRESHOLD_USER=5
# LOGIN_LOCK_SECONDS_USER=900
