/* pages/user/index.wxss */

.page-user {
  min-height: 100vh;
  background: var(--bg-color);
  /* 预留底部 tab-bar 高度 + 安全区，避免内容被遮挡 */
  padding-bottom: calc(var(--tab-bar-height) + 20rpx);
}

/* 点击反馈 */
.tap-hover {
  opacity: 0.7;
}

/* ===== 头部用户信息区 ===== */
.user-header {
  position: relative;
  overflow: hidden;
  padding: 60rpx 40rpx 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad63 55%, #048a57 100%);
}

/* 装饰圆形，增加层次感 */
.header-decor {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.decor-1 {
  width: 320rpx;
  height: 320rpx;
  top: -120rpx;
  right: -80rpx;
}

.decor-2 {
  width: 220rpx;
  height: 220rpx;
  bottom: -100rpx;
  left: -40rpx;
  background: rgba(255, 255, 255, 0.06);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #fff;
  border: 6rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

/* 已登录但无头像时的兜底 */
.avatar-fallback {
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  border: 6rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.avatar-placeholder {
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 6rpx solid rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.nickname {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 已登录徽章 */
.login-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--primary-color);
  background: #fff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 未登录状态：头部内嵌登录按钮 */
.header-login-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary-color);
  background: #fff;
  padding: 16rpx 36rpx;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 功能区卡片（叠压头部下沿） ===== */
.content-card {
  position: relative;
  z-index: 2;
  margin: -56rpx 24rpx 0;
  background: var(--white);
  border-radius: 24rpx;
  padding: 12rpx 32rpx 8rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.card-section-title {
  font-size: 26rpx;
  color: var(--text-light);
  padding: 20rpx 0 4rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* 图标彩色底座 */
.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.icon-bg-0 { background: #ffebeb; }
.icon-bg-1 { background: #fff6e0; }
.icon-bg-2 { background: #e8f8ee; }
.icon-bg-3 { background: #e8f0fe; }

.menu-icon {
  font-size: 38rpx;
  line-height: 1;
}

.menu-title {
  font-size: 30rpx;
  color: var(--text-color);
}

.menu-arrow {
  font-size: 36rpx;
  color: #cccccc;
}

/* ===== 退出登录 ===== */
.logout-btn {
  margin: 40rpx 24rpx 0;
  padding: 26rpx;
  text-align: center;
  background: var(--white);
  color: var(--danger-color);
  font-size: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}