/* pages/user/reviews.wxss */

.page-reviews {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 20rpx 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

.loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-light);
}

.review-item {
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.review-product {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
  margin-bottom: 16rpx;
}

.product-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.product-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-arrow {
  font-size: 32rpx;
  color: var(--text-light);
  margin-left: 12rpx;
}

.review-stars {
  font-size: 28rpx;
  color: #ff9500;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.review-content {
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.6;
  margin-bottom: 16rpx;
  overflow-wrap: break-word;
}

.review-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.meta-chip {
  font-size: 20rpx;
  color: var(--primary-color);
  background: #e8f8ee;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
}

.review-time {
  font-size: 22rpx;
  color: var(--text-light);
}

.review-delete {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--danger-color);
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--danger-color);
  border-radius: 24rpx;
}

.review-delete:active {
  opacity: 0.7;
}

.load-more,
.no-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  padding: 24rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: var(--text-light);
}