<!--pages/user/settings.wxml-->
<view class="page-settings">
  <!-- 账号信息 -->
  <view class="settings-group card">
    <view class="settings-item">
      <text class="settings-label">当前账号</text>
      <text class="settings-value">{{isLogin ? (username || '已登录') : '未登录'}}</text>
    </view>
    <view class="settings-item" wx:if="{{isLogin}}">
      <block wx:if="{{hasWxBind}}">
        <text class="settings-label">💬 微信绑定</text>
        <text class="settings-value">已绑定</text>
      </block>
      <block wx:else>
        <text class="settings-label clickable" bindtap="onBindWechat">{{binding ? '绑定中...' : '💬 绑定微信'}}</text>
        <text class="settings-arrow" bindtap="onBindWechat">›</text>
      </block>
    </view>
    <view class="settings-item" wx:if="{{isLogin}}">
      <text class="settings-label clickable" bindtap="onTogglePasswordForm">🔐 {{hasPassword ? '修改密码' : '设置账号密码'}}</text>
      <text class="settings-arrow" bindtap="onTogglePasswordForm">›</text>
    </view>
    <view class="settings-item">
      <text class="settings-label">版本号</text>
      <text class="settings-value">v{{version}}</text>
    </view>
  </view>

  <!-- 设置/修改密码表单（点「设置账号密码」后展开） -->
  <view class="settings-group card password-form" wx:if="{{showPasswordForm}}">
    <view class="form-title">{{hasPassword ? '修改密码' : '设置账号密码'}}</view>
    <view class="form-tip" wx:if="{{!hasPassword}}">设置后可在电脑网页版用「用户名+密码」登录同一账号</view>
    <view class="form-item" wx:if="{{!hasPassword}}">
      <input class="form-input" placeholder="用户名（2-20位，可选，便于PC登录）" value="{{newUsername}}" bindinput="onNewUsernameInput" />
    </view>
    <view class="form-item" wx:if="{{hasPassword}}">
      <input class="form-input" password placeholder="原密码" value="{{oldPassword}}" bindinput="onOldPasswordInput" />
    </view>
    <view class="form-item">
      <input class="form-input" password placeholder="新密码（至少8位，含字母和数字）" value="{{newPassword}}" bindinput="onNewPasswordInput" />
    </view>
    <view class="form-item">
      <input class="form-input" password placeholder="确认新密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
    </view>
    <button class="form-submit" bindtap="onSubmitPassword" disabled="{{submitting}}">{{submitting ? '提交中...' : '确认设置'}}</button>
  </view>

  <!-- 通用操作 -->
  <view class="settings-group card">
    <view class="settings-item clickable" hover-class="tap-hover" bindtap="onClearCache">
      <text class="settings-label">🧹 清除缓存</text>
      <text class="settings-arrow">›</text>
    </view>
    <view class="settings-item clickable" hover-class="tap-hover" bindtap="onAbout">
      <text class="settings-label">ℹ️ 关于宠物宝</text>
      <text class="settings-arrow">›</text>
    </view>
    <view class="settings-item clickable" hover-class="tap-hover" bindtap="onFeedback">
      <text class="settings-label">💬 意见反馈</text>
      <text class="settings-arrow">›</text>
    </view>
  </view>

  <view class="settings-footer">
    <text>宠物宝 · 科学养宠助手</text>
  </view>
</view>