/* pages/user/favorites.wxss */

.page-favorites {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 20rpx 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

.loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-light);
}

.fav-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.fav-cover {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
  margin-right: 20rpx;
}

.fav-cover image {
  width: 100%;
  height: 100%;
}

.fav-body {
  flex: 1;
  min-width: 0;
}

.fav-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.fav-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.meta-tag {
  font-size: 20rpx;
  color: var(--text-secondary);
  background: var(--bg-color);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.meta-tag.brand {
  color: var(--primary-color);
  background: #e8f8ee;
}

.fav-score {
  font-size: 22rpx;
  color: var(--text-light);
}

.score-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.fav-remove {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-light);
  border-radius: 50%;
}

.fav-remove:active {
  background: var(--bg-color);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: var(--text-light);
  margin-bottom: 32rpx;
}

.empty-btn {
  font-size: 26rpx;
  color: #fff;
  background: var(--primary-color);
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
}