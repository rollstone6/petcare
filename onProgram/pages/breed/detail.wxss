/* pages/breed/detail.wxss */

.page-detail {
  min-height: 100vh;
  background: var(--bg-color);
  /* 底部安全区留白 */
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 头部信息区 */
.header-section {
  background: var(--white);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.header-content {
  display: flex;
  gap: 30rpx;
  margin-bottom: 30rpx;
}

.breed-avatar-large {
  width: 240rpx;
  height: 240rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f0f0f0;
  flex-shrink: 0;
}

.breed-avatar-large image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.breed-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.breed-name {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-color);
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  overflow-wrap: break-word;
}

.breed-name-en {
  font-size: 26rpx;
  font-weight: normal;
  color: var(--text-light);
}

.breed-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.tag-species {
  background: #dbeafe;
  color: #1e40af;
}

.tag-size {
  background: #e5e7eb;
  color: #4b5563;
}

.tag-hypoallergenic {
  background: #d1fae5;
  color: #065f46;
}

.temperament-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.temperament-tag {
  padding: 8rpx 20rpx;
  background: #fef3c7;
  color: #92400e;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: 1rpx solid #fbbf24;
}

.breed-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-top: 8rpx;
}

/* 基础信息卡片网格 */
.info-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.info-card {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.info-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 22rpx;
  color: var(--text-light);
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
}

/* 常见健康问题 */
.health-issues {
  background: #fef3c7;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.issues-content {
  font-size: 26rpx;
  color: #92400e;
  line-height: 1.6;
}

/* 推荐产品区 */
.products-section {
  padding: 0 30rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-header .section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 0;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-card {
  background: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.product-image {
  width: 100%;
  height: 200rpx;
  background: #f0f0f0;
}

.product-image image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-color);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-brand {
  font-size: 22rpx;
  color: var(--text-light);
  margin-bottom: 12rpx;
}

.product-score {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.score-star {
  font-size: 24rpx;
}

.score-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #f59e0b;
}

/* 加载中 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  color: var(--text-light);
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-state .icon {
  font-size: 120rpx;
  color: var(--text-light);
  margin-bottom: 20rpx;
}

.empty-state .text {
  color: var(--text-light);
  font-size: 28rpx;
}
