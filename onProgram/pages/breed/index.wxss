/* pages/breed/index.wxss */

.page-breed {
  min-height: 100vh;
  background: var(--bg-color);
  /* 预留底部 tab-bar 高度 + 安全区，避免内容被遮挡 */
  padding-bottom: calc(var(--tab-bar-height) + 20rpx);
}

/* 物种分类Tab */
.species-tabs {
  white-space: nowrap;
  background: var(--white);
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
}

/* 内层容器承载左右留白，避免横向滚动到最右时最后一个标签被裁切 */
.species-tabs-inner {
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
}

.species-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 40rpx;
  background: var(--white);
  border: 1rpx solid var(--border-color);
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.species-tab:last-child {
  margin-right: 0;
}

.species-tab.active {
  background: var(--primary-color);
  color: var(--white);
  border-color: var(--primary-color);
}

.species-tab .icon {
  font-size: 28rpx;
}

.species-tab .label {
  font-size: 26rpx;
}

/* 排序选项 */
.sort-options {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx;
  background: var(--white);
  border-bottom: 1rpx solid var(--border-color);
}

.sort-title {
  font-size: 24rpx;
  color: var(--text-light);
}

.sort-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: var(--white);
  border: 1rpx solid var(--border-color);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.sort-item.active {
  background: #fef3c7;
  color: #d97706;
  border-color: #fbbf24;
}

.sort-item .icon {
  font-size: 24rpx;
}

.sort-item .label {
  font-size: 24rpx;
}

/* 品种网格：两列布局，卡片更宽敞，侧边留白更足 */
.breed-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 24rpx;
}

.breed-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--white);
  border-radius: 16rpx;
  padding: 32rpx 24rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
  /* 防止网格子项内容过宽导致整行溢出屏幕 */
  min-width: 0;
}

.breed-card:active {
  transform: scale(0.95);
}

.breed-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f5f5f5;
  margin-bottom: 20rpx;
  border: 4rpx solid var(--white);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.breed-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.breed-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  text-align: center;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.breed-species {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

/* 加载中 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  color: var(--text-light);
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-state .icon {
  font-size: 120rpx;
  color: var(--text-light);
  margin-bottom: 20rpx;
}

.empty-state .text {
  color: var(--text-light);
  font-size: 28rpx;
}
